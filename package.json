{
  "name": "alexa-llm",
  "version": "1.0.0",
  "description": "Alexa skill for talking to Claude",
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "ask": "tsx scripts/ask.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node16 --format=cjs --minify --sourcemap --sources-content=false --legal-comments=none --outfile=lambda/index.js",
    "package": "npm run build && mkdir -p dist && rm -f dist/lambda.zip && cd lambda && zip -q ../dist/lambda.zip index.js index.js.map package.json && cd .. && ls -lh dist/lambda.zip"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jk0/alexa-llm.git"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-dynamodb": "3.721.0",
    "@aws-sdk/client-s3": "3.721.0",
    "@aws-sdk/lib-dynamodb": "3.721.0",
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-model": "^1.86.0",
    "undici": "^5.29.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
